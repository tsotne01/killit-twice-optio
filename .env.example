# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=optio_db
POSTGRES_USER=optio_user
POSTGRES_PASSWORD=optio_password

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=customers

# RabbitMQ
RABBITMQ_URL=amqp://optio_user:optio_password@localhost:5672
RABBITMQ_EXCHANGE=customer.events
RABBITMQ_QUEUE=customer.events.audit_queue

# Pipeline Configuration
PIPELINE_BATCH_SIZE=500
PIPELINE_POLL_INTERVAL_MS=1000
API_PORT=4000
UI_PORT=3000
